#!/usr/bin/env bash
# Create a git worktree for one piece of work, following the ~/ai convention:
#   scripts/new-worktree <type>/<name> [base]
#     branch : <type>/<name>            (reused if it already exists)
#     path   : ../worktrees/<project>/<name>-<type>   (beside the main checkout)
#     base   : main, unless given
#
# Nothing gitignored is copied in. In particular config.json stays in the main checkout:
# a worktree with it could start a second live bot. Tests need no config.
set -euo pipefail

ref="${1:-}"
base="${2:-main}"
case "$ref" in
  */*) ;;
  *) echo "usage: scripts/new-worktree <type>/<name> [base]   e.g. feature/reaction-votes" >&2; exit 2 ;;
esac
type="${ref%%/*}"
name="${ref#*/}"
if [[ -z "$type" || -z "$name" || "$name" == */* ]]; then
  echo "error: use exactly one '/', as in feature/reaction-votes (got '$ref')" >&2
  exit 2
fi

# The main checkout, even when this runs inside another worktree.
main_root="$(dirname "$(realpath "$(git rev-parse --git-common-dir)")")"
project="$(basename "$main_root")"
path="$(dirname "$main_root")/worktrees/$project/$name-$type"
if [[ -e "$path" ]]; then
  echo "error: $path already exists" >&2
  exit 1
fi

if git -C "$main_root" show-ref --verify --quiet "refs/heads/$ref"; then
  git -C "$main_root" worktree add "$path" "$ref"
else
  git -C "$main_root" worktree add -b "$ref" "$path" "$base"
fi
mise trust --quiet "$path/mise.toml"

echo "worktree ready:"
echo "  branch : $ref"
echo "  path   : $path"
echo "  tests  : (cd $path && mise run test)"
echo "  ship   : from $main_root, mise run ship $ref"
