# Secrets and real config. Real values live in config.json and ~/.config/gentalent/.
# Commit config.example.json instead.
config.json
*.token
.env
.env.*
!.env.example
*.pem
*.key
tumblr.json
credentials*.json
secrets*.json

# Runtime state: live and dry-run ballots, SQLite WAL/SHM/lock files, DB backups, AI media.
.state/
*.sqlite3
*.sqlite3-*
*.sqlite3.lock
*.db

# Pinned live checkout (git worktree managed by scripts/deploy.sh)
.live/

# Generated output (regenerate instead of committing)
exports/
TEST_RESULTS.txt
welven_da_great_text/

# mise local overrides
mise.local.toml
.mise.local.toml
mise.*.local.toml

# Editors, OS, and Windows-to-WSL copy artifacts
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
*:Zone.Identifier

# ArcLint run cache
.arclint/cache/

# Go binaries built in place
/cmd/gentalent/gentalent
/bin/
